      "optional": true
    },
    "is-unicode-supported": {
      "optional": true
    },
    "figures": {
      "optional": true
    },
    "ink-text-input": {
      "optional": true
    },
    "ink-select-input": {
      "optional": true
    },
    "ink-spinner": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/sdk-node": {
      "optional": true
    },
    "@opentelemetry/instrumentation-pino": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "@opentelemetry/sdk-metrics": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/exporter-metrics-otlp-http": {
      "optional": true
    },
    "fuse.js": {
      "optional": true
    },
    "@opentelemetry/api-logs": {
      "optional": true
    },
    "@opentelemetry/sdk-logs": {
      "optional": true
    },
    "@opentelemetry/exporter-logs-otlp-http": {
      "optional": true
    },
    "ansi-escapes": {
      "optional": true
    },
    "terminal-link": {
      "optional": true
    },
    "supports-hyperlinks": {
      "optional": true
    },
