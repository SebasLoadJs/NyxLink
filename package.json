      "optional": true
    },
    "pino-abstract-transport": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./aurora": {
      "types": "./examples/aurora-pipeline.d.mts",
      "import": "./examples/aurora-pipeline.mjs"
    },
    "./aurora/bootstrap": {
      "types": "./examples/aurora-bootstrap.d.mts",
      "import": "./examples/aurora-bootstrap.mjs"
    },
    "./aurora/inspector": {
      "types": "./examples/aurora-inspector.d.mts",
      "import": "./examples/aurora-inspector.mjs"
    },
    "./aurora/diagnostics": {
      "types": "./examples/aurora-diagnostics.d.mts",
      "import": "./examples/aurora-diagnostics.mjs"
    },
    "./aurora/otel": {
      "types": "./examples/aurora-otel.d.mts",
      "import": "./examples/aurora-otel.mjs"
    },
    "./aurora/sdk": {
      "types": "./examples/aurora-sdk.d.cts",
      "default": "./examples/aurora-sdk.cjs"
    },
    "./aurora/file": {
      "types": "./examples/aurora-file.d.mts",
      "import": "./examples/aurora-file.mjs"
    }
  },
  "bin": {
    "nyxlink-aurora": "./examples/aurora-demo.mjs"
  }
}
