+
+/**
+ * WAV-over-HTTP must retain its RIFF header before decoding. The general
+ * seekable-stream byte-offset heuristic starts in the middle of that headerless
+ * container, causing the decoder to abort. Decode from zero, then discard
+ * exact 48-kHz stereo S16LE PCM bytes in a bounded-memory generator.
+ *
+ * This is a correctness fallback for the built-in HTTP WAV source. It costs
+ * bandwidth/CPU proportional to seek position, but does not affect MP3,
+ * MP4, WebM, local sources or passthrough modes.
+ */
+function createPcmSkipStream(source: DestroyableReadable, bytesToSkip: number): Readable {
+  return Readable.from(
+    (async function* () {
+      let remaining = bytesToSkip
+      for await (const value of source) {
+        const chunk = Buffer.isBuffer(value) ? value : Buffer.from(value)
+        const skipped = Math.min(remaining, chunk.length)
+        remaining -= skipped
+        if (skipped < chunk.length) yield chunk.subarray(skipped)
+      }
+      if (remaining > 0) {
+        throw new Error('HTTP WAV seek exceeded available decoded PCM data.')
+      }
+    })(),
+    { objectMode: false, highWaterMark: 19200 }
+  )
+}
+
+/** Scope the fallback to explicit WAV HTTP sources; never guess audio codecs. */
+function isHttpWavSource(sourceName: string, urlResult: TrackUrlResult): boolean {
+  if (sourceName !== 'http' || typeof urlResult.url !== 'string') return false
+  const hint = typeof urlResult.format === 'string' ? urlResult.format.toLowerCase() : ''
+  if (/^(?:wav|wave|audio\\/(?:x-)?wav|audio\\/wave)$/.test(hint)) return true
+  try {
+    const pathname = new URL(urlResult.url).pathname.toLowerCase()
+    return pathname.endsWith('.wav') || pathname.endsWith('.wave')
+  } catch {
+    return false
+  }
+}
